createCollection.usuarios();

createView("mayoresActivos",
  find.usuarios()
    .filter(!(edad < 18) && (activo == true || categoria == "gold"))
    .groupby(edad)
      .count("total", edad)
      .having(total > 1)
    .preview()
);



useView("mayoresActivos")
  .filter(edad > 25)
  .sort({edad: desc})
  .limit(5)
  .preview();

useView("mayoresActivos");


dropCollection.usuarios()
