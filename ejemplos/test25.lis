insertMany.animales([
  { name: "Pez globo", age: 24, tipo: "acuatico" },
  { name: "Moncholo", age: 30, tipo: "acuatico" },
  { name: "Palometa", age: 18, tipo: "acuatico" },
  { name: "Tukan", age: 40, tipo: "volador" },
  { name: "Aguila", age: 35, tipo: "volador" }
]);


find.animales()
  .filter(exists(tipo) && age > 3)
  .groupby(tipo)
  .sum("totalEdad", age)
  .avg("promEdad", age)
  .having(promEdad > 10)
  .sort({promEdad: desc})
  .preview()
